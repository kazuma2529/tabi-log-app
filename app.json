{
  "expo": {
    "name": "旅ログ - 世界制覇ログ",
    "slug": "tabi-log-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/tabi-log-icon.png",
    "scheme": "tabilog",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kazuma.tabilog",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "旅ログ",
        "NSPhotoLibraryUsageDescription": "訪問した国の思い出の写真や動画をアプリに保存するために、写真ライブラリへのアクセスを使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tabi-log-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE3"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e64a7bd-5564-4c6d-8922-6b5a2d9e668b"
      }
    }
  }
}
